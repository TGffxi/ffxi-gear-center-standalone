{
  "name": "FFXI Gear Center",
  "version": "1.0.2",
  "date": "2026-09-28",
  "kind": "public-standalone-distribution",
  "basis": "public-sanitized 1.0.1 product code plus standalone lifecycle delta",
  "release_status": "PUBLIC-STANDALONE",
  "public_distribution": {
